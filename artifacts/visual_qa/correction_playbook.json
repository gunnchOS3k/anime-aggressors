{
  "schema_version": 1,
  "system": "GoldenVisualQA",
  "taxonomy": {
    "MISSING_MODEL": {
      "severity": "S0",
      "likely_causes": ["cache miss", "instance freed", "generation race", "viewport empty"],
      "diagnostic_steps": [
        "inspect FighterPresentationCache occupancy for context key",
        "inspect PresentationContext.cache_key(fighter_id, context)",
        "inspect SubViewport / display Sprite2D visibility",
        "run wave020-select-lifecycle-diagnostic or battle-body diagnostic",
        "capture non-invasive screen witness (no material heal)"
      ]
    },
    "WRONG_FIGHTER": {
      "severity": "S0",
      "likely_causes": ["stale cache entry", "focus index desync", "wrong fighter_id binding"],
