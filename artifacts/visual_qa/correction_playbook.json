        "compare expected fighter_id vs witness fighter_id",
        "inspect select focus telemetry",
        "force context-local instance rebuild for that surface only"
      ]
    },
    "LEGACY_MODEL": {
      "severity": "S1",
      "likely_causes": ["old GLB path", "procedural fallback unexpectedly used", "asset path regression"],
      "diagnostic_steps": [
        "inspect model_source in witness",
