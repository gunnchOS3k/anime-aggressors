# Stream C quarantine binary copies (ledger JSON is committed)
artifacts/digital_engineering_exhaustion/stream_c/quarantine/unclear_third_party/*
!artifacts/digital_engineering_exhaustion/stream_c/quarantine/unclear_third_party/.gitkeep

# Local owner-review executable pack; never publish with the source branch.
artifacts/v1_closure/review/downloads/*.pck

# Reproducible OVA raw capture frames; assembled owner preview remains tracked.
artifacts/v1_closure/review/owner_override/ova/frames/

# Bounded ordinary-review renderer sequences; MP4/representative PNG evidence is tracked.
# Raw frames remain locally preserved for review and re-encoding.
artifacts/v1_closure/ordinary_review/*/frames_*/

# Temporary formant previews: local development only; redistribution not cleared.
game-godot/assets/audio/story_temp/
artifacts/v1_closure/dialogue_performance/local_media/

# Bounded native spectral VFX recordings and diagnostic logs remain local.
artifacts/v1_closure/spectral_feedback/local_media/
