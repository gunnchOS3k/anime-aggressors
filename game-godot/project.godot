; Anime Aggressors — Primary Godot 4 Runtime (game-godot)
config_version=5

[application]
config/name="Anime Aggressors"
config/description="Primary local platform fighter runtime — Godot 4"
run/main_scene="res://scenes/boot/BootScene.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"
config/quit_on_go_back=false
boot_splash/image="res://assets/branding/splash-icon.png"
boot_splash/bg_color=Color(0.04, 0.05, 0.11, 1)

[autoload]
GameState="*res://scripts/core/GameState.gd"
AchievementRuntime="*res://scripts/core/AchievementRuntime.gd"
AchievementToast="*res://scripts/ui/achievement_toast.gd"
SceneRouter="*res://scripts/core/SceneRouter.gd"
TouchInputManager="*res://scripts/input/touch_input_manager.gd"
NavigationAuthority="*res://scripts/core/NavigationAuthority.gd"
DeviceRoleRuntime="*res://scripts/core/DeviceRoleRuntime.gd"
MatchTelemetry="*res://scripts/core/MatchTelemetry.gd"
AudioDirector="*res://scripts/audio/AudioDirector.gd"
ProductionGateHarness="*res://scripts/rc/production_gate_harness.gd"
Wave015PhysicalHarness="*res://scripts/rc/wave015_physical_harness.gd"
Wave015CrashCensusHarness="*res://scripts/rc/wave015_crash_census_harness.gd"
Wave015BattleSceneStabilityHarness="*res://scripts/rc/wave015_battlescene_stability_harness.gd"
Wave016PixelCaptureHarness="*res://scripts/rc/wave016_pixel_capture_harness.gd"
Wave017PixelCloseoutHarness="*res://scripts/rc/wave017_pixel_closeout_harness.gd"
Wave020Cp2PixelPhysicalHarness="*res://scripts/rc/wave020_cp2_pixel_physical_harness.gd"
RuntimeFlightRecorder="*res://scripts/diagnostics/runtime_flight_recorder.gd"
Wave018VisibilityTelemetry="*res://scripts/diagnostics/wave018_visibility_telemetry.gd"
CrossDeviceContractRunner="*res://scripts/cross_device/cross_device_contract_runner.gd"
JuiceEventBus="*res://scripts/juice/juice_event_bus.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

